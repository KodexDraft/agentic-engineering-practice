{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run dev)",
      "Bash(npm start)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:reset)",
      "Bash(npx jest:*)"
